# Copy to .env.local (git-ignored). Never commit real values or CLI tokens.
# Local SpacetimeDB (default):
NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:3001
NEXT_PUBLIC_SPACETIME_DATABASE=rising-waters-local

# Maincloud: replace the two lines above with these, using your own published database name.
# NEXT_PUBLIC_SPACETIME_URI=wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIME_DATABASE=<your-database-name>

# Radio broadcast. Server-only: never prefix any of these with NEXT_PUBLIC_.
# Grok writes the script (with audio tags like [sighs]); ElevenLabs voices it, one voice per speaker.
# Without XAI_API_KEY the anchor just reads the debrief. Without ELEVENLABS_API_KEY the game is silent.
# XAI_API_KEY=
# XAI_MODEL=grok-4.20-0309-non-reasoning
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4          # radio blip (multi-voice dialogue)
# ELEVENLABS_SPEAK_MODEL=eleven_v4     # advisor lines; eleven_flash_v2_5 is faster but sounds robotic
# Optional voice-id overrides, one per speaker (defaults: Daniel, Liam, Bill, Lily, Harry, Roger, all premade):
# ELEVENLABS_VOICE_ANCHOR=
# ELEVENLABS_VOICE_REPORTER=
# ELEVENLABS_VOICE_OSTRA=
# ELEVENLABS_VOICE_MOSS=
# ELEVENLABS_VOICE_BRASK=
# ELEVENLABS_VOICE_PELL=
